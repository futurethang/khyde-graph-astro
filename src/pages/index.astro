---
import Base from '../layouts/Base.astro';
import GraphStage from '../components/graph/GraphStage.astro';
---

<Base>
  <section class="hero">
    <kh-wordmark>
      <h1 class="wordmark">Kevin Hyde</h1>
    </kh-wordmark>
    <p class="lead">
      Design engineer. What I bring on the left, what it makes on the right — anchored on what I'm building now.
    </p>
  </section>
  <GraphStage />
</Base>

<script>
  import '../elements/kh-wordmark';
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
    align-items: end;
    gap: var(--s-8);
    padding: var(--s-8) var(--gutter) var(--s-6);
  }
  .wordmark {
    font-size: var(--fs-wordmark);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: var(--tracking-tight);
    color: var(--c-ink);
    text-shadow: -3px 0 rgb(255 59 59 / 0.85), 3px 0 rgb(59 107 255 / 0.85), 0 1.5px rgb(43 227 107 / 0.5);
  }
  .lead {
    font-size: var(--fs-lead);
    line-height: 1.3;
    font-weight: 500;
    text-wrap: pretty;
  }
  @media (max-width: 767px) {
    .hero { grid-template-columns: 1fr; gap: var(--s-4); }
    .lead { font-size: 1.125rem; }
  }
</style>
