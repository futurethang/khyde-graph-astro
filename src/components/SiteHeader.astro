---
const links = [
  { href: '/about', label: 'About' },
  { href: '/reading', label: 'Reading' },
  { href: '/lab', label: 'Lab' },
  { href: 'https://blog.kevinhyde.com', label: 'Writing' },
];
---

<header class="site-header mono">
  <a href="/" class="home">KH — kevinhyde.com</a>
  <nav aria-label="Site">
    <ul>
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      <li><a href="#contact" class="hello">Say hello →</a></li>
    </ul>
  </nav>
</header>

<style>
  @layer components {
    .site-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--s-4);
      padding: var(--s-8) var(--gutter) 0;
      font-size: 0.6875rem;
    }
    ul { display: flex; flex-wrap: wrap; gap: var(--s-6); }
    .hello { color: var(--c-amber); }
    @media (max-width: 767px) {
      .site-header { flex-direction: column; gap: var(--s-3); }
      ul { gap: var(--s-4); }
    }
  }
</style>
